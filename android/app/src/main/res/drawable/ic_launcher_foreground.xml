        android:pathData="M44,57 L50,47 L56,57 Z" />

    <!-- Download arrow shaft. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,70 L54,78" />

    <!-- Download arrow head. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M49,76 L54,82 L59,76 Z" />

