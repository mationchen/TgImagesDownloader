    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Photo frame (rounded rect). -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M37,34 L71,34 Q74,34 74,37 L74,64 Q74,67 71,67 L37,67 Q34,67 34,64 L34,37 Q34,34 37,34 Z" />

    <!-- Mountain glyph inside the frame. -->
    <path
